{
  "name": "perspektive",
  "version": "0.1.3",
  "description": "Multi-manifold React graph renderer for Neuro-Symbolic AI (Poincaré, Klein, Minkowski, Bloch).",
  "type": "module",
  "main": "./dist/perspektive.umd.js",
  "module": "./dist/perspektive.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/perspektive.es.js",
      "require": "./dist/perspektive.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoseRFJuniorLLMs/perspektive.js.git"
  },
  "keywords": [
    "react",
    "graph",
    "hyperbolic",
    "poincare",
    "webgl",
    "ai",
    "rag",
    "neuro-symbolic"
  ],
  "author": "JoseRFJuniorLLMs",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@tanstack/react-query": "^5.90.21",
    "flatbuffers": "^25.9.23",
    "three": "^0.183.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^18.2.0 || ^19.0.0",
    "@types/react-dom": "^18.2.0 || ^19.0.0",
    "@types/three": "^0.183.1",
    "@webgpu/types": "^0.1.69",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^3.6.0",
    "vitest": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
